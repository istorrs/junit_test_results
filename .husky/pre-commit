echo "🔍 Running code quality checks..."
echo ""

# Run lint-staged for staged files
npx lint-staged

# If lint-staged passed, show success message
if [ $? -eq 0 ]; then
  echo ""
  echo "✅ Linting checks passed!"
  echo ""
else
  echo ""
  echo "❌ Code quality checks failed. Please fix the errors above."
  echo "💡 Tip: Run 'npm run lint:fix' to automatically fix some issues."
  echo ""
  exit 1
fi

# Run npm audit in client directory
# sharp is allowlisted: it's a devDependency used only by the manual
# client/scripts/convert-icons.cjs utility (never runs in build/dev/test),
# and its only fix is a breaking major-version bump (npm audit fix --force).
echo "🔒 Running security audit for client..."
cd client
CLIENT_AUDIT_JSON=$(npm audit --audit-level=moderate --json 2>/dev/null || true)
CLIENT_REMAINING=$(echo "$CLIENT_AUDIT_JSON" | jq -r '.vulnerabilities // {} | to_entries[] | select(.key != "sharp") | .key')
cd ..

if [ -n "$CLIENT_REMAINING" ]; then
  echo ""
  echo "❌ Client security audit failed! Unresolved vulnerable packages:"
  echo "$CLIENT_REMAINING"
  echo "💡 Run 'cd client && npm audit fix' to fix vulnerabilities"
  echo ""
  exit 1
fi

# Run npm audit in backend directory
echo "🔒 Running security audit for backend..."
cd backend
npm audit --audit-level=moderate
BACKEND_AUDIT=$?
cd ..

if [ $BACKEND_AUDIT -ne 0 ]; then
  echo ""
  echo "❌ Backend security audit failed!"
  echo "💡 Run 'cd backend && npm audit fix' to fix vulnerabilities"
  echo ""
  exit 1
fi

echo ""
echo "✅ All code quality and security checks passed!"
echo ""
